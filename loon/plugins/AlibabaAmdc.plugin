#!name=阿里系 amdc
#!desc=对指定阿里系 UA 的纯 HTTP 调度响应返回无效内容；是否回退 HTTPS 须真机验证。
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/9d/81/f8/9d81f836-fcaf-f7fc-6150-04f2761764fe/AppIcon-0-0-1x_U007emarketing-0-10-0-85-220.png/100x100bb.png
# Written for this repo (2026-10-06); same rule as quantumultx/rewrite/AlibabaAmdc.conf and the Surge
# module alibaba-amdc. It replaces the amdc rules of the ddgksf2013 GoofishAds and DaMaiAds plugins.

[Script]
http-response ^http:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,4}(:\d+)?\/amdc\/mobileDispatch script-path=https://raw.githubusercontent.com/wenbingkun/proxy-config/main/quantumultx/scripts/amdc.js, requires-body=true, timeout=10, tag=阿里系amdc
