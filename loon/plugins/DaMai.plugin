# Restored home/profile promotion rules: ddgksf2013.top DaMaiAds snapshot, fetched 2026-10-05;
# source SHA-256 d84394841aa834397e1fafd4b5b447c67a8472e35a5bf05a66a44d5265be8043.
# amdc and search-disabling rules excluded; no runtime request to the personal site.
#!name=大麦去广告
#!desc=大麦去广告
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/c5/23/4c/c5234cd0-5980-c184-e14a-41ca193e83f0/AppIcon-0-0-1x_U007emarketing-0-6-0-85-220.png/100x100bb.png
# 大麦 (2026-10-06): rules written for this repo, replacing ddgksf2013's DaMaiAds. The splash rule comes
# from fmz200's split Damai (fmz200/wool_scripts@5d5f63f); its amdc reject is left out because the
# standalone 阿里系 amdc item handles the dispatch. Popup, floating window and preload ads are kept on
# the interfaces the ddgksf2013 version used; home/profile promotion cleanup restored from the frozen 2026-10-05 source; search remains usable.

[Rewrite]
^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.damai\.wireless\.home\.welcome reject-200
^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.damai\.mec\.popup\.get reject-200
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.damai\.wireless\.home\.float\/[\d.]+\/ response-body-json-jq '.data={}'
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.independentadvertiseapi\.querypreloadadvlist\/[\d.]+\/ response-body-json-jq '.data.adList=[]'

^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.damai\.mec\.aristotle\.get\/[\d.]+\/ response-body-json-jq '.data.data.top.keywords=[] | .data.data.top.aiUrl="" | .data.data.top.aiLottieUrl="" | .data.data.top.aiLottieAmbientUrl="" | .data.data.top.arScan={} | .data.nodes=((.data.nodes // []) | map(select(((.nodes[0].data.componentId // "") != "dm_home_supper_banner"))) | map(if ((.nodes[0].data.componentId // "") == "dm_pioneer_function_area_with_city_rank") then .nodes[0].nodes=((.nodes[0].nodes // []) | map(select(.data.title != "天天抽奖"))) else . end) | map(if ((.nodes[0].data.componentId // "") == "dm_pioneer_home_feed") then .nodes[0].nodes=((.nodes[0].nodes // []) | map(if (.nodes? != null) then .nodes=((.nodes // []) | map(select(.data.cardType != "15" and .data.cardType != "21"))) else . end)) else . end))'
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.damai\.wireless\.home\.appglobalconfig\/[\d.]+\/ response-body-json-jq '.data.pop={} | .data.searchTip={} | .data.searchTips=[] | .data.headLottie={} | .data.headStyle={}'
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.mtopmindapi\.loadwantshowlotteryanimationurl\/[\d.]+\/ response-body-json-jq '.data.returnValue={}'
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.damai\.wireless\.user\.my\.content\.get\/[\d.]+\/ response-body-json-jq '.data.banner=[] | .data.dynamicMenu.itemList=((.data.dynamicMenu.itemList // []) | map(select(.title != "周边商城" and .title != "观演团" and .title != "电影包场" and .title != "公益三小时" and .title != "大麦VIP卡" and .title != "特惠专区"))) | .data.performFilmVip={} | .data.showVip=false | .data.vipCardInfo={}'

[MITM]
hostname = acs.m.taobao.com
