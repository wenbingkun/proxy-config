# Restored home/profile promotion rules: ddgksf2013.top DaMaiAds snapshot, fetched 2026-10-05;
# source SHA-256 d84394841aa834397e1fafd4b5b447c67a8472e35a5bf05a66a44d5265be8043.
# amdc and search-disabling rules excluded; no runtime request to the personal site.
#!name=大麦去广告
#!desc=大麦去广告
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/c5/23/4c/c5234cd0-5980-c184-e14a-41ca193e83f0/AppIcon-0-0-1x_U007emarketing-0-6-0-85-220.png/100x100bb.png
# 大麦 (2026-10-06): rules written for this repo, replacing ddgksf2013's DaMaiAds. The splash rule comes
# from fmz200's split Damai (fmz200/wool_scripts@5d5f63f); its amdc reject is left out because the
# standalone 阿里系 amdc item handles the dispatch. Popup, floating window and preload ads are kept on
# the interfaces the ddgksf2013 version used; home/profile promotion cleanup restored from the frozen 2026-10-05 source; search remains usable.

# 2026-10-24: one switch per app or feature (Loon plugin arguments). [Rewrite] lines were converted to Loon's new
# syntax with the official rewrite converter (input: main f55a1d380df3c3ad1c4631be4a7b2bdad8d6a2a3) and gated by
# "${switch} == true && "; [Script] lines stay classic with enable={switch}. This file is now the source of truth:
# edit the new-syntax lines directly. A switch only stops this plugin; other plugins (e.g. blackmatrix7) may still
# block the same request.

[Argument]
dm_splash = switch,true,false,tag=开屏与弹窗,desc=开屏与弹窗广告；blackmatrix7 去广告也拦截其中部分接口，关闭后可能仍无变化
dm_home = switch,true,false,tag=首页,desc=浮窗、预加载广告、首页推广与抽奖动画；搜索提示保留
dm_my = switch,true,false,tag=我的页,desc=我的页推广

[Rewrite]
request if ${dm_splash} == true && ${url} ~= /^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.damai\.wireless\.home\.welcome/i then reject(200)
request if ${dm_splash} == true && ${url} ~= /^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.damai\.mec\.popup\.get/i then reject(200)
response if ${dm_home} == true && ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.damai\.wireless\.home\.float\/[\d.]+\//i then response.json.jq(".data={}")
response if ${dm_home} == true && ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.independentadvertiseapi\.querypreloadadvlist\/[\d.]+\//i then response.json.jq(".data.adList=[]")

response if ${dm_home} == true && ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.damai\.mec\.aristotle\.get\/[\d.]+\//i then response.json.jq(".data.data.top.aiUrl=\"\" | .data.data.top.aiLottieUrl=\"\" | .data.data.top.aiLottieAmbientUrl=\"\" | .data.data.top.arScan={} | .data.nodes=((.data.nodes // []) | map(select(((.nodes[0].data.componentId // \"\") != \"dm_home_supper_banner\"))) | map(if ((.nodes[0].data.componentId // \"\") == \"dm_pioneer_function_area_with_city_rank\") then .nodes[0].nodes=((.nodes[0].nodes // []) | map(select(.data.title != \"天天抽奖\"))) else . end) | map(if ((.nodes[0].data.componentId // \"\") == \"dm_pioneer_home_feed\") then .nodes[0].nodes=((.nodes[0].nodes // []) | map(if (.nodes? != null) then .nodes=((.nodes // []) | map(select(.data.cardType != \"15\" and .data.cardType != \"21\"))) else . end)) else . end))")
response if ${dm_home} == true && ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.damai\.wireless\.home\.appglobalconfig\/[\d.]+\//i then response.json.jq(".data.pop={} | .data.headLottie={} | .data.headStyle={}")
response if ${dm_home} == true && ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.mtopmindapi\.loadwantshowlotteryanimationurl\/[\d.]+\//i then response.json.jq(".data.returnValue={}")
response if ${dm_my} == true && ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.damai\.wireless\.user\.my\.content\.get\/[\d.]+\//i then response.json.jq(".data.banner=[] | .data.dynamicMenu.itemList=((.data.dynamicMenu.itemList // []) | map(select(.title != \"周边商城\" and .title != \"观演团\" and .title != \"电影包场\" and .title != \"公益三小时\" and .title != \"大麦VIP卡\" and .title != \"特惠专区\"))) | .data.performFilmVip={} | .data.showVip=false | .data.vipCardInfo={}")

[MITM]
hostname = acs.m.taobao.com
