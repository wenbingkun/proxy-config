# Mirror of fmz200's Loon split plugin; generated by scripts/build_loon_plugins.py, do not edit by hand.
# Source: https://raw.githubusercontent.com/fmz200/wool_scripts/5d5f63fcf98bc69d5f8f1b1bae6f86a01ee4bb97/Loon/plugin/split/partD/Douban.lpx
# Source SHA-256: 87f863947a0ff69b8c8bc1bf636f6461de63aa391c09d32820605ebc1c6b334a
# Only change: #!icon (upstream uses a 560 KB animated GIF) is the app's App Store icon.
#############################################

[Rule]
DOMAIN-SUFFIX, erebor.douban.com, REJECT
DOMAIN-SUFFIX, ad.doubanio.com, REJECT


[Rewrite]
# 如开启可自行添加主机名 img*.douban.com, frodo.douban.com, erebor.douban.com
^https?:\/\/api\.douban\.com\/v\d\/app_ads\/ reject-dict
^https?:\/\/api\.douban\.com\/b.*\/common_ads\?.* reject-dict
^https?:\/\/img\d\.doubanio\.com\/view\/dale-online\/dale_ad\/ reject
^https?:\/\/frodo\.douban\.com\/api\/v2\/movie\/banner reject
^https?:\/\/erebor\.douban\.com\/count\/\?ad= reject


[MITM]
hostname = api.douban.com
