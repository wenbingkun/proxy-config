# Installed-app startup subset of ddgksf2013 StartUpAds snapshot fetched 2026-10-05.
# Source SHA-256: fb9c1530eac7e921c007f7d1e9113aef11b7319fa8613e3a2bdaf15f88690a72
# No scripts, amdc or full legacy MitM list; existing verified three-app rules retained.
#!name=开屏补充
#!desc=已安装 App 裁剪开屏补充；保留神州、滴滴、一嗨已验证规则；不包含 amdc
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/9d/81/f8/9d81f836-fcaf-f7fc-6150-04f2761764fe/AppIcon-0-0-1x_U007emarketing-0-10-0-85-220.png/100x100bb.png

# 2026-10-24: one switch per app or feature (Loon plugin arguments). [Rewrite] lines were converted to Loon's new
# syntax with the official rewrite converter (input: main f55a1d380df3c3ad1c4631be4a7b2bdad8d6a2a3) and gated by
# "${switch} == true && "; [Script] lines stay classic with enable={switch}. This file is now the source of truth:
# edit the new-syntax lines directly. A switch only stops this plugin; other plugins (e.g. blackmatrix7) may still
# block the same request.

[Argument]
ss_zuche = switch,true,false,tag=神州租车,desc=营销开屏
ss_1hai = switch,true,false,tag=一嗨租车,desc=4 张已核验的开屏素材
ss_didi = switch,true,false,tag=滴滴出行,desc=广告图片目录与活动接口；blackmatrix7 去广告也拦截其中部分接口，关闭后可能仍无变化
ss_alibaba_ads = switch,true,false,tag=阿里系广告服务,desc=多个阿里系 App 共用的 getadv；blackmatrix7 去广告也拦截此接口，关闭后可能仍无变化
ss_1688 = switch,true,false,tag=1688,desc=首页开屏
ss_taobao = switch,true,false,tag=淘宝,desc=首页开屏
ss_pdd = switch,true,false,tag=拼多多,desc=开屏；blackmatrix7 去广告也拦截此接口，关闭后可能仍无变化
ss_dewu = switch,true,false,tag=得物,desc=开屏广告；blackmatrix7 去广告也拦截此接口，关闭后可能仍无变化

[Rewrite]
request if ${ss_zuche} == true && ${url} ~= /^https:\/\/apiproxy\.zuche\.com\/resource\/cardes\/toufang\/marketing\/v1(?:\?|$)/i then reject_dict(200)
request if ${ss_1hai} == true && ${url} ~= /^https:\/\/externalimage\.1hai\.cn\/512\/(?:987dcb4241584cca926c2d34f5ff59db|499f25d69e14475a89e5436bd47f8293|3e3b519297244eeca14710366411df22|04c29fd6157947c882ceb04f311f64fe)\.jpg(?:\?|$)/i then reject(404)
request if ${ss_didi} == true && ${url} ~= /^https:\/\/img-ys011\.didistatic\.com\/static\/ad_oss\//i then reject(404)

# alibaba
request if ${ss_alibaba_ads} == true && ${url} ~= /^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alibaba\.advertisementservice\.getadv\//i then reject(200)
# alibaba
request if ${ss_1688} == true && ${url} ~= /^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alibaba\.cbu\.app\.homepage\.startup/i then reject(200)
# pinduoduo
request if ${ss_pdd} == true && ${url} ~= /^https?:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/cappuccino\/splash/i then reject(200)
# taobao
request if ${ss_taobao} == true && ${url} ~= /^https?:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.wireless\.home\.splash\.awesome\.get/i then reject(200)
# dewu
request if ${ss_dewu} == true && ${url} ~= /^https:\/\/app\.dewu\.com\/api\/v1\/app\/advertisement\//i then reject(200)
# didichuxing
request if ${ss_didi} == true && ${url} ~= /^https?:\/\/res\.xiaojukeji\.com\/resapi\/activity\/mget/i then reject(200)
# didichuxing
request if ${ss_didi} == true && ${url} ~= /^https?:\/\/res\.xiaojukeji\.com\/resapi\/activity\/get(Ruled|Preload|PasMultiNotices)/i then reject(200)

[MITM]
hostname = apiproxy.zuche.com, img-ys011.didistatic.com, externalimage.1hai.cn, acs.m.taobao.com, api.pinduoduo.com, api.yangkeduo.com, guide-acs.m.taobao.com, app.dewu.com, res.xiaojukeji.com
