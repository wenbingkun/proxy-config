#!name=微信
#!desc=外链解锁（被拦截的外部链接弹出通知，点击用浏览器打开；需允许 Loon 通知）与公众号文章底部广告，可分别开关。商品推广由 blackmatrix7 去广告拦截，不受开关控制。
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/61/70/2e/61702e05-0531-165f-5cd3-012c8b5b3b20/AppIcon-0-0-1x_U007epad-0-1-0-sRGB-0-85-220.png/100x100bb.png
# Written for this repo (2026-10-24). Replaces Kelee's Weixin_external_links_unlock.lpx and
# fmz200-WeChatOfficialAccount.plugin on Loon. Sources:
#   unblock: zZPiglet UnblockURLinWeChat.js pinned at 0a70fbe27dfb072dac29423d661ed3c47cf66aab (same as QX/Surge)
#   official accounts: the getappmsgad rule of fmz200 WeChatOfficialAccount.lpx @5d5f63f, run as
#   quantumultx/scripts/wechat-mp.js so that the switch can gate it. Its cps_product_info rule is left to
#   blackmatrix7 Advertising (request-phase reject-200). MitM hosts cannot be switched.
# Hand-written, not generated. To refresh: pin a newer zZPiglet commit, or re-derive the getappmsgad rule from a
# newer fmz200 commit into a new wechat-mp script path, and send it through a PR.

[Argument]
wx_unblock = switch,true,false,tag=外链解锁,desc=需在 iOS 设置中允许 Loon 通知
wx_mp_ads = switch,true,false,tag=公众号去广告,desc=文章底部广告；商品推广由 blackmatrix7 去广告拦截

[Script]
http-response ^https\:\/\/(weixin110\.qq|security.wechat)\.com\/cgi-bin\/mmspamsupport-bin\/newredirectconfirmcgi\? script-path=https://raw.githubusercontent.com/zZPiglet/Task/0a70fbe27dfb072dac29423d661ed3c47cf66aab/asset/UnblockURLinWeChat.js, requires-body=true, timeout=60, tag=微信外链解锁, enable={wx_unblock}
http-response ^https?:\/\/mp\.weixin\.qq\.com\/mp\/getappmsgad script-path=https://raw.githubusercontent.com/wenbingkun/proxy-config/main/quantumultx/scripts/wechat-mp.js, requires-body=true, timeout=10, tag=公众号去广告, enable={wx_mp_ads}

[MITM]
hostname = weixin110.qq.com, security.wechat.com, mp.weixin.qq.com
