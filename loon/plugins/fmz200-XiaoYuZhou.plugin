[Rewrite]
# 首页净化
^https?:\/\/api\.xiaoyuzhoufm\.com\/v\d\/discovery-feed\/list response-body-json-jq '.data |= map(select(.type != "DISCOVERY_BANNER"))'
#

# 移除开屏广告
^https?:\/\/api\.xiaoyuzhoufm\.com\/v\d\/flash-screen\/list(\?|$) reject-dict

# 移除搜索框内容
^https?:\/\/api\.xiaoyuzhoufm\.com\/v\d\/search\/(get-express|get-preset)(\?|$) reject-dict
^https?:\/\/api\.xiaoyuzhoufm\.com\/v\d\/category\/list-daily-suggestion(\?|$) reject-dict


[MITM]
hostname = api.xiaoyuzhoufm.com
