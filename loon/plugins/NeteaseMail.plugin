#!name=网易邮箱大师去广告
#!desc=网易邮箱大师去广告
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/ac/2d/4f/ac2d4ffc-f481-f3aa-cbff-65a7ebc9c04c/AppIconStore-0-0-1x_U007emarketing-0-8-0-85-220.png/100x100bb.png
# 网易邮箱大师 (2026-10-06): rules written for this repo, replacing ddgksf2013's NeteaseMailAds. The
# first two come from fmz200's QX split snippet NetEaseMail (fmz200/wool_scripts@5d5f63f; its Loon and
# Surge files at that commit hold unrelated NetEase Music rules, so they are not used); the other three
# cover ad slots fmz200 misses (floating icon, free-mailbox reminder, task promotion). Page-config promotion cleanup restored from
# ddgksf2013/Rewrite@dc3ea2c1fb2db870676b26da24006083eb1d44d3; user-info quota remains intact.

# 2026-10-24: one switch per app or feature (Loon plugin arguments). [Rewrite] lines were converted to Loon's new
# syntax with the official rewrite converter (input: main f55a1d380df3c3ad1c4631be4a7b2bdad8d6a2a3) and gated by
# "${switch} == true && "; [Script] lines stay classic with enable={switch}. This file is now the source of truth:
# edit the new-syntax lines directly. A switch only stops this plugin; other plugins (e.g. blackmatrix7) may still
# block the same request.

[Argument]
nm_ads = switch,true,false,tag=广告,desc=开屏与列表广告；blackmatrix7 去广告也拦截其中部分接口，关闭后可能仍无变化
nm_task = switch,true,false,tag=任务推广,desc=任务中心推广
nm_config = switch,true,false,tag=页面配置,desc=浮动图标、免费邮箱提醒与页面推广；用户信息与容量保留

[Rewrite]
request if ${nm_ads} == true && ${url} ~= /^https?:\/\/appconf\.mail\.163\.com\/mmad\//i then reject(200)
request if ${nm_ads} == true && ${url} ~= /^https?:\/\/client\.mail\.163\.com\/apptrack\/confinfo\/(searchMultiAds|showAds)/i then reject(404)
request if ${nm_config} == true && ${url} ~= /^https?:\/\/appconf\.mail\.163\.com\/mailmaster\/api\/config\/function\.do/i then reject_dict(200)
request if ${nm_config} == true && ${url} ~= /^https?:\/\/appconf\.mail\.163\.com\/mailmaster\/getRegConfig\.do/i then reject_dict(200)
request if ${nm_task} == true && ${url} ~= /^https?:\/\/dashi\.163\.com\/task-center-api\/fapi\/task/i then reject_dict(200)

response if ${nm_config} == true && ${url} ~= /^https?:\/\/appconf\.mail\.163\.com\/mailmaster\/api\/page\/.*conf\.do/i then response.json.jq("if (.data | type) == \"object\" then .data |= del(.masterLoginGuideList, .masterOperatorList, .functionOperatorInfoList, .memberOperator, .activityTabInfoList, .extList) else . end")

[MITM]
hostname = appconf.mail.163.com, client.mail.163.com, dashi.163.com
