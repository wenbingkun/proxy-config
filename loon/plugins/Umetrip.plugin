#!name=航旅纵横去广告
#!desc=仓库维护的可读 JSON / Protobuf 净化；保留正常业务字段
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/f3/24/9f/f3249f91-f692-a1a4-ea79-df11a012566f/AppIcon-0-0-1x_U007emarketing-0-7-0-85-220.png/100x100bb.png
# Native endpoint and image rules match quantumultx/rewrite/Umetrip.conf.
# binary-body-mode is required to preserve Protobuf responses.

[Rewrite]
^https?:\/\/(discardrp|startup)\.umetrip\.com\/gateway\/api\/umetrip\/native(?:\?.*)?$ - reject-200
^https:\/\/oss\.umetrip\.com\/fs\/advert\/ - reject-img

[Script]
# > 开屏/动作弹窗/AdvertisementApi、首页运营位、瀑布流、会员营销与行程扩容推广
http-response ^https:\/\/(?:sns|appmsg|home|umehome|opactivity|activity|umerp|flightstatus|umeflightstatus|startup|umestartup|user|umeuser|event)\.umetrip\.com\/gateway\/api\/umetrip\/native(?:\?.*)?$ script-path=https://raw.githubusercontent.com/wenbingkun/proxy-config/442b4ef2a10564bbbecbdcdd392abc806e7d222e/quantumultx/scripts/umetrip.js, requires-body=true, binary-body-mode=true, timeout=60, tag=umetrip

[MITM]
hostname = discardrp.umetrip.com, sns.umetrip.com, appmsg.umetrip.com, home.umetrip.com, umehome.umetrip.com, opactivity.umetrip.com, activity.umetrip.com, umerp.umetrip.com, flightstatus.umetrip.com, umeflightstatus.umetrip.com, startup.umetrip.com, umestartup.umetrip.com, user.umetrip.com, umeuser.umetrip.com, event.umetrip.com, oss.umetrip.com
