#!name=闲鱼
#!desc=某些APP要清除缓存或者重新安装拦截广告才会生效！
#!author=奶思
#!homepage=https://github.com/fmz200/wool_scripts
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/a7/7d/97/a77d970b-9da7-9154-56ab-46f114ea7736/AppIcon-0-0-1x_U007epad-0-1-0-sRGB-85-220.png/100x100bb.png
#!raw-url=https://raw.githubusercontent.com/fmz200/wool_scripts/5d5f63fcf98bc69d5f8f1b1bae6f86a01ee4bb97/Loon/plugin/split/partX/XianYu.lpx
#!tg-channel=https://t.me/inaisi
#!date=
# Frozen copy of fmz200's Loon split plugin for Xianyu; do not edit by hand.
# Source: https://raw.githubusercontent.com/fmz200/wool_scripts/5d5f63fcf98bc69d5f8f1b1bae6f86a01ee4bb97/Loon/plugin/split/partX/XianYu.lpx
# Source SHA-256: 2efa04ef64f8b3e005cfc99bc15b81efde6f51ea9a1100da5acede919f178474
# Changes (2026-10-06):
#   - removed 1 line(s) matching amdc\\/mobileDispatch
#   - pinned 7x https://raw.githubusercontent.com/ishowshu/qx/refs/heads/main/ -> d38e228
#   - pinned 1x https://github.com/fmz200/wool_scripts/raw/main/ -> 5d5f63f
#   - pinned 1x https://raw.githubusercontent.com/fmz200/wool_scripts/main/ -> 5d5f63f
#   - the amdc dispatch reject (the standalone 阿里系 amdc item handles it for every client)
#   - added idle.ad.expose (splash ads)
#   - 2026-10-24: one switch per feature group; [Rewrite] lines converted to Loon's new syntax with the official
#     rewrite converter (input: main f55a1d380df3c3ad1c4631be4a7b2bdad8d6a2a3) and gated by "${switch} == true && ";
#     [Script] lines stay classic with enable={switch}. A switch only stops this plugin.
# To refresh, fetch the source at a new commit, redo these changes (convert [Rewrite] with the official Loon
# rewrite converter, then re-apply the switch conditions) and send it through a PR.
#############################################

[Argument]
xy_splash = switch,true,false,tag=开屏与广告曝光,desc=开屏广告与广告曝光上报
xy_home = switch,true,false,tag=首页,desc=闲鱼币入口、发布球、首页信息流广告、顶部频道菜单、常访问的圈子
xy_search = switch,true,false,tag=搜索,desc=搜索栏填充词、多余推荐列表、搜索结果信息流广告
xy_item = switch,true,false,tag=商品详情,desc=详情页底部推荐、周边推荐、「这些宝贝超好卖」
xy_social = switch,true,false,tag=我的、消息与关注,desc=我的页底部推荐、消息页与关注页的推荐和圈子横幅、个人主页
xy_local = switch,true,false,tag=同城,desc=定位地区信息流广告与同城页横幅

[Rule]
DOMAIN-KEYWORD,iyes.youku.com,REJECT



[Rewrite]
request if ${xy_splash} == true && ${url} ~= /^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.idle\.ad\.expose/i then reject(200)
# 搜索页多余推荐列表
request if ${xy_search} == true && ${url} ~= /^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.item\.search\.activate\/2\.0/i then reject_dict(200)
request if ${xy_search} == true && ${url} ~= /^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search\.discover\/1\.0/i then reject_dict(200)
# 这些宝贝超好卖
request if ${xy_item} == true && ${url} ~= /^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.item\.resell\.recommendorhotcate\/1\.0/i then reject_dict(200)
# 用闲鱼币买更便宜
request if ${xy_home} == true && ${url} ~= /^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.idle\.coin\.nextfresh\/1\.0/i then reject_dict(200)
# 闲鱼我的页面底部商品推荐
request if ${xy_social} == true && ${url} ~= /^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.item\.buy\.feeds/i then reject_dict(200)
# 消息页感兴趣推荐
request if ${xy_social} == true && ${url} ~= /^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.playboy\.recommend\/1\.0/i then reject(404)
# 开屏广告
request if ${xy_splash} == true && ${url} ~= /^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlecommerce\.splash\.ads/i then reject_dict(200)

# 搜索栏填充词
response if ${xy_search} == true && ${url} ~= /^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search\.shade\//i then response.json.jq("del(.data)")
# 首页闲鱼币入口、底部发布球
response if ${xy_home} == true && ${url} ~= /^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.user\.strategy\.list\//i then response.json.jq("del(.data)")
# 关注的人页面圈子横幅
response if ${xy_social} == true && ${url} ~= /^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.group\.myself\.banner\//i then response.json.jq(".data.bannerList = []")
# 主页关注的人感兴趣推荐
response if ${xy_social} == true && ${url} ~= /^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.playboy\.recommend\/2\.0/i then response.json.jq(".data.recommends = [] | .data.items = [] | .data.next = false")
# 商品详情页底部推荐
response if ${xy_item} == true && ${url} ~= /^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.item\.recommend\.list\//i then response.json.jq(".data.cardList = []")
# 首页关注频道常访问的圈子
response if ${xy_home} == true && ${url} ~= /^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.fun\.follow\.often\.visit/i then response.json.jq(".data.sections = []")
# 主页关注页面圈子新横幅
response if ${xy_social} == true && ${url} ~= /^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.circle\.myself\.banner\/1\.0/i then response.json.jq(".data.bannerList = []")
# 主页关注页面圈子常访问
response if ${xy_social} == true && ${url} ~= /^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.circle\.visited\/1\.0/i then response.json.jq(".data.visitedCircleList = []")


[Script]
# 商品信息流广告
http-response ^https:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.home\.nextfresh\/ script-path = https://raw.githubusercontent.com/ishowshu/qx/d38e2289f4f388dfc55aaa8f19c8d002d828f62a/script/goofish.js, requires-body = true, tag = 商品信息流广告, enable={xy_home}
# 定位地区页面的信息流广告
http-response ^https:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.local\.home\/ script-path = https://raw.githubusercontent.com/ishowshu/qx/d38e2289f4f388dfc55aaa8f19c8d002d828f62a/script/goofish.js, requires-body = true, tag = 定位地区页面的信息流广告, enable={xy_local}
# 个人主页
http-response ^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.idle\.user\.page\.my\.adapter\/ script-path = https://raw.githubusercontent.com/ishowshu/qx/d38e2289f4f388dfc55aaa8f19c8d002d828f62a/script/goofish.js, requires-body = true, tag = 个人主页, enable={xy_social}
# 首页顶部频道菜单
http-response ^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.home\.circle\.list\/1\.0 script-path = https://raw.githubusercontent.com/ishowshu/qx/d38e2289f4f388dfc55aaa8f19c8d002d828f62a/script/goofish.js, requires-body = true, tag = 首页顶部频道菜单, enable={xy_home}
# 商品详情页周边推荐
http-response ^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.local\.nearby\.itemdetail\.enter\/1\.0 script-path = https://raw.githubusercontent.com/ishowshu/qx/d38e2289f4f388dfc55aaa8f19c8d002d828f62a/script/goofish.js, requires-body = true, tag = 商品详情页周边推荐, enable={xy_item}
# 搜索结果信息流广告
http-response ^https:\/\/g-acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search\/ script-path = https://raw.githubusercontent.com/ishowshu/qx/d38e2289f4f388dfc55aaa8f19c8d002d828f62a/script/goofish.js, requires-body = true, tag = 搜索结果信息流广告, enable={xy_search}
# 同城页横幅广告
http-response ^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.local\.flow\.plat\.section script-path = https://raw.githubusercontent.com/ishowshu/qx/d38e2289f4f388dfc55aaa8f19c8d002d828f62a/script/goofish.js, requires-body = true, tag = 同城页横幅广告, enable={xy_local}


[MITM]
hostname = acs.m.goofish.com, g-acs.m.goofish.com
