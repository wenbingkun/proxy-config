# Frozen copy of fmz200's Loon split plugin for Xianyu; do not edit by hand.
# Source: https://raw.githubusercontent.com/fmz200/wool_scripts/5d5f63fcf98bc69d5f8f1b1bae6f86a01ee4bb97/Loon/plugin/split/partX/XianYu.lpx
# Source SHA-256: 2efa04ef64f8b3e005cfc99bc15b81efde6f51ea9a1100da5acede919f178474
# Changes (2026-10-06):
#   - removed 1 line(s) matching amdc\\/mobileDispatch
#   - pinned 7x https://raw.githubusercontent.com/ishowshu/qx/refs/heads/main/ -> d38e228
#   - pinned 1x https://github.com/fmz200/wool_scripts/raw/main/ -> 5d5f63f
#   - pinned 1x https://raw.githubusercontent.com/fmz200/wool_scripts/main/ -> 5d5f63f
#   - the amdc dispatch reject (the standalone 阿里系 amdc item handles it for every client)
#   - added idle.ad.expose (splash ads)
# To refresh, fetch the source at a new commit, redo these changes and send it through a PR.
#############################################

[Rule]
DOMAIN-KEYWORD,iyes.youku.com,REJECT



[Rewrite]
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.idle\.ad\.expose reject-200
# 搜索页多余推荐列表
^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.item\.search\.activate\/2\.0 reject-dict
^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search\.discover\/1\.0 reject-dict
# 这些宝贝超好卖
^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.item\.resell\.recommendorhotcate\/1\.0 reject-dict
# 用闲鱼币买更便宜
^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.idle\.coin\.nextfresh\/1\.0 reject-dict
# 闲鱼我的页面底部商品推荐
^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.item\.buy\.feeds reject-dict
# 消息页感兴趣推荐
^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.playboy\.recommend\/1\.0 reject
# 开屏广告
^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlecommerce\.splash\.ads reject-dict

# 搜索栏填充词
^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search\.shade\/ response-body-json-jq 'del(.data)'
# 首页闲鱼币入口、底部发布球
^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.user\.strategy\.list\/ response-body-json-jq 'del(.data)'
# 关注的人页面圈子横幅
^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.group\.myself\.banner\/ response-body-json-jq '.data.bannerList = []'
# 主页关注的人感兴趣推荐
^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.playboy\.recommend\/2\.0 response-body-json-jq '.data.recommends = [] | .data.items = [] | .data.next = false'
# 商品详情页底部推荐
^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.item\.recommend\.list\/ response-body-json-jq '.data.cardList = []'
# 首页关注频道常访问的圈子
^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.fun\.follow\.often\.visit response-body-json-jq '.data.sections = []'
# 主页关注页面圈子新横幅
^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.circle\.myself\.banner\/1\.0 response-body-json-jq '.data.bannerList = []'
# 主页关注页面圈子常访问
^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.circle\.visited\/1\.0 response-body-json-jq '.data.visitedCircleList = []'


[Script]
# 商品信息流广告
http-response ^https:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.home\.nextfresh\/ script-path = https://raw.githubusercontent.com/ishowshu/qx/d38e2289f4f388dfc55aaa8f19c8d002d828f62a/script/goofish.js, requires-body = true, tag = 商品信息流广告
# 定位地区页面的信息流广告
http-response ^https:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.local\.home\/ script-path = https://raw.githubusercontent.com/ishowshu/qx/d38e2289f4f388dfc55aaa8f19c8d002d828f62a/script/goofish.js, requires-body = true, tag = 定位地区页面的信息流广告
# 个人主页
http-response ^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.idle\.user\.page\.my\.adapter\/ script-path = https://raw.githubusercontent.com/ishowshu/qx/d38e2289f4f388dfc55aaa8f19c8d002d828f62a/script/goofish.js, requires-body = true, tag = 个人主页
# 首页顶部频道菜单
http-response ^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.home\.circle\.list\/1\.0 script-path = https://raw.githubusercontent.com/ishowshu/qx/d38e2289f4f388dfc55aaa8f19c8d002d828f62a/script/goofish.js, requires-body = true, tag = 首页顶部频道菜单
# 商品详情页周边推荐
http-response ^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.local\.nearby\.itemdetail\.enter\/1\.0 script-path = https://raw.githubusercontent.com/ishowshu/qx/d38e2289f4f388dfc55aaa8f19c8d002d828f62a/script/goofish.js, requires-body = true, tag = 商品详情页周边推荐
# 搜索结果信息流广告
http-response ^https:\/\/g-acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search\/ script-path = https://raw.githubusercontent.com/ishowshu/qx/d38e2289f4f388dfc55aaa8f19c8d002d828f62a/script/goofish.js, requires-body = true, tag = 搜索结果信息流广告
# 同城页横幅广告
http-response ^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.local\.flow\.plat\.section script-path = https://raw.githubusercontent.com/ishowshu/qx/d38e2289f4f388dfc55aaa8f19c8d002d828f62a/script/goofish.js, requires-body = true, tag = 同城页横幅广告


[MITM]
hostname = acs.m.goofish.com, g-acs.m.goofish.com
