#!name=诊断 HTTP API（仅本地）
#!desc=让局域网内的 WSL 读取 Surge 的请求记录、DNS 和事件。复制为 netdiag-api.sgmodule，只放在设备的 iCloud Drive/Surge，不进仓库。
#!category=proxy-config · 家庭与本地

# scripts/netdiag.py reads /v1/requests/recent and friends from this API (see
# docs/netdiag.md). Replace the key with a long random string and put the same key in
# ~/.config/ios-netdiag/env as SURGE_KEY. The API listens on every interface, so on a foreign
# Wi-Fi anyone who learns the key could control Surge; turn the module off there if that matters.
[General]
http-api = examplekey@0.0.0.0:6171
