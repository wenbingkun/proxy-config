#!name=机场 DNS（仅本地）
#!desc=用机场要求的加密 DNS 解析，包括节点主机名。复制为 airport-dns.sgmodule，只放在设备的 iCloud Drive/Surge，不进仓库。
#!category=proxy-config

# Surge has no per-proxy resolver, and proxy hostnames never match [Host] entries (manual: Local
# DNS Mapping), so the only way to resolve the nodes through the airport's DNS is the global
# encrypted-dns-server. A module overrides the [General] value that bootstrap.conf includes from
# the managed profile. Copy the value from the [General] encrypted-dns-server line of the
# airport's own profile (Airport.conf). This sends every DNS query Surge makes outside home
# through the airport's DNS, which is what the airport's own profile does; the home
# [SSID Setting] in bootstrap.conf still hands DNS to the router.
[General]
encrypted-dns-server = https://doh.example.com/dns-query
