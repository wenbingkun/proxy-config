# Native Surge source maintained by proxy-config; endpoint and image rules match
# quantumultx/rewrite/AmapPageCleanup.conf. Reviewed device results: 2026-10-06.
#!name=高德页面净化
#!desc=保留已验收的个人页、首页社交栏目与打车推广列表净化；顶部商业卡片暂缓
#!category=proxy-config

[Script]
amap-page-cleanup = type=http-response, pattern=^https:\/\/(?:m5\.amap\.com\/ws\/(?:shield\/dsp\/profile\/index\/nodefaasv3|info_bff\/ContentCenter)|m5-zb\.amap\.com\/ws\/promotion-web\/resource\/home)(?:\?|$), requires-body=true, max-size=262144, timeout=10, script-path=https://raw.githubusercontent.com/wenbingkun/proxy-config/main/quantumultx/scripts/amap-page-cleanup.js

[MITM]
hostname = %APPEND% m5.amap.com, m5-zb.amap.com
