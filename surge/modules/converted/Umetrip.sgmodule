#!name=航旅纵横去广告
#!desc=仓库维护的可读 JSON / Protobuf 净化
# Native Surge source maintained by proxy-config; endpoint and image rules match
# quantumultx/rewrite/Umetrip.conf. binary-body-mode is required for Protobuf.

[Map Local]
^https?:\/\/(discardrp|startup)\.umetrip\.com\/gateway\/api\/umetrip\/native(?:\?.*)?$ data-type=text data=" " status-code=200
^https:\/\/oss\.umetrip\.com\/fs\/advert\/ data-type=tiny-gif status-code=200

[Script]
# > 开屏/动作弹窗/AdvertisementApi、首页运营位、瀑布流、会员营销与行程扩容推广
umetrip = type=http-response, pattern=^https:\/\/(?:sns|appmsg|home|umehome|opactivity|activity|umerp|flightstatus|umeflightstatus|startup|umestartup|user|umeuser|event)\.umetrip\.com\/gateway\/api\/umetrip\/native(?:\?.*)?$, script-path=https://raw.githubusercontent.com/wenbingkun/proxy-config/9f2bd622348198b7eaa84ccbfe2c57bc010e7bfd/quantumultx/scripts/umetrip.js, requires-body=true, binary-body-mode=1, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% discardrp.umetrip.com, sns.umetrip.com, appmsg.umetrip.com, home.umetrip.com, umehome.umetrip.com, opactivity.umetrip.com, activity.umetrip.com, umerp.umetrip.com, flightstatus.umetrip.com, umeflightstatus.umetrip.com, startup.umetrip.com, umestartup.umetrip.com, user.umetrip.com, umeuser.umetrip.com, event.umetrip.com, oss.umetrip.com
