# Frozen Surge conversion of proxy-config's Quantumult X rewrite; do not edit by hand.
# Source: quantumultx/rewrite/DaMai.conf (same rules; reject -> URL Rewrite reject, reject-200 and
# reject-dict -> Map Local, jsonjq -> http-response-jq). Change both files together.

[Map Local]
^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.damai\.wireless\.home\.welcome data-type=text data=" " status-code=200
^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.damai\.mec\.popup\.get data-type=text data=" " status-code=200

[Body Rewrite]
http-response-jq ^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.damai\.wireless\.home\.float\/[\d.]+\/ '.data={}'
http-response-jq ^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.independentadvertiseapi\.querypreloadadvlist\/[\d.]+\/ '.data.adList=[]'

http-response-jq ^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.damai\.mec\.aristotle\.get\/[\d.]+\/ '.data.data.top.aiUrl="" | .data.data.top.aiLottieUrl="" | .data.data.top.aiLottieAmbientUrl="" | .data.data.top.arScan={} | .data.nodes=((.data.nodes // []) | map(select(((.nodes[0].data.componentId // "") != "dm_home_supper_banner"))) | map(if ((.nodes[0].data.componentId // "") == "dm_pioneer_function_area_with_city_rank") then .nodes[0].nodes=((.nodes[0].nodes // []) | map(select(.data.title != "天天抽奖"))) else . end) | map(if ((.nodes[0].data.componentId // "") == "dm_pioneer_home_feed") then .nodes[0].nodes=((.nodes[0].nodes // []) | map(if (.nodes? != null) then .nodes=((.nodes // []) | map(select(.data.cardType != "15" and .data.cardType != "21"))) else . end)) else . end))'
http-response-jq ^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.damai\.wireless\.home\.appglobalconfig\/[\d.]+\/ '.data.pop={} | .data.headLottie={} | .data.headStyle={}'
http-response-jq ^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.mtopmindapi\.loadwantshowlotteryanimationurl\/[\d.]+\/ '.data.returnValue={}'
http-response-jq ^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.damai\.wireless\.user\.my\.content\.get\/[\d.]+\/ '.data.banner=[] | .data.dynamicMenu.itemList=((.data.dynamicMenu.itemList // []) | map(select(.title != "周边商城" and .title != "观演团" and .title != "电影包场" and .title != "公益三小时" and .title != "大麦VIP卡" and .title != "特惠专区"))) | .data.performFilmVip={} | .data.showVip=false | .data.vipCardInfo={}'

[MITM]
hostname = %APPEND% acs.m.taobao.com
