#!name=网易邮箱大师去广告
#!desc=网易邮箱大师去广告。需要 MitM。由仓库生成。
#!category=proxy-config

# Generated by scripts/build_surge_modules.py. Do not edit by hand; change SOURCES there and rerun.
# Source: proxy-config NeteaseMail surge/modules/converted/NeteaseMail.sgmodule
#   sha256 d9787e26159f9f2b358c918894f6c19387a62e0bd1bdfe51032965b53fd2d934; arguments: defaults

[URL Rewrite]
^https?:\/\/client\.mail\.163\.com\/apptrack\/confinfo\/(searchMultiAds|showAds) - reject

[Map Local]
^https?:\/\/appconf\.mail\.163\.com\/mmad\/ data-type=text data=" " status-code=200
^https?:\/\/appconf\.mail\.163\.com\/mailmaster\/api\/config\/function\.do data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/appconf\.mail\.163\.com\/mailmaster\/getRegConfig\.do data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/dashi\.163\.com\/task-center-api\/fapi\/task data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq ^https?:\/\/appconf\.mail\.163\.com\/mailmaster\/api\/page\/.*conf\.do 'if (.data | type) == "object" then .data |= del(.masterLoginGuideList, .masterOperatorList, .functionOperatorInfoList, .memberOperator, .activityTabInfoList, .extList) else . end'

[MITM]
hostname = %APPEND% appconf.mail.163.com, client.mail.163.com, dashi.163.com
