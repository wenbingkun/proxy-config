#!name=豆瓣 App 去广告
#!desc=豆瓣 App 广告；横幅与部分启动图所在主机没有解密，不在覆盖范围。需要 MitM。含拒绝规则，「在家直连 + 拦截」要排在本模块之后。由仓库生成。
#!category=proxy-config

# Generated by scripts/build_surge_modules.py. Do not edit by hand; change SOURCES there and rerun.
# Source: fmz200 Douban https://raw.githubusercontent.com/fmz200/wool_scripts/5d5f63fcf98bc69d5f8f1b1bae6f86a01ee4bb97/Surge/module/split/partD/Douban.sgmodule
#   sha256 156a34ab59e07c64fa3cdb892cc36c23f6d06bfd0f9c0374a3545cdf0dae53b5; arguments: defaults

[Rule]
DOMAIN-SUFFIX,erebor.douban.com,REJECT
DOMAIN-SUFFIX,ad.doubanio.com,REJECT

[URL Rewrite]
^https?:\/\/img\d\.doubanio\.com\/view\/dale-online\/dale_ad\/ - reject
^https?:\/\/frodo\.douban\.com\/api\/v2\/movie\/banner - reject
^https?:\/\/erebor\.douban\.com\/count\/\?ad= - reject

[Map Local]
# 如开启可自行添加主机名 img*.douban.com, frodo.douban.com, erebor.douban.com
^https?:\/\/api\.douban\.com\/v\d\/app_ads\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/api\.douban\.com\/b.*\/common_ads\?.* data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% api.douban.com
