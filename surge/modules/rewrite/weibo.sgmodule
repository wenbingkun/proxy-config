#!name=微博去广告
#!desc=微博与微博国际版去广告。需要 MitM。含拒绝规则，「在家直连 + 拦截」要排在本模块之后。由仓库生成，不要与「去广告与增强合集」同时启用。
#!category=proxy-config

# Generated by scripts/build_surge_modules.py. Do not edit by hand; change SOURCES there and rerun.
# Source: ddgksf2013 WeiboAds surge/modules/converted/WeiboAds.sgmodule
#   sha256 91b6e6cd6af5a30e3793a5e73010d6a1deafe0321646c168f79726e20348451f; arguments: defaults

[Rule]
# > 微博_分流@ddgksf2013
DOMAIN,sdkapp.uve.weibo.com,DIRECT
DOMAIN,adstrategy.biz.weibo.com,REJECT
# > 微博国际版_开屏拦截@ddgksf2013
DOMAIN-SUFFIX,api.touch-moblie.com,REJECT

[URL Rewrite]
# > 微博_应用内弹窗广告@ddgksf2013
^https?:\/\/(preload-click|preload-impression)\.uve\.weibo\.com\/(interface\/wbpullad\/wbpullad_click\.php|wbapplua\/get_wbpullad_log\.lua) - reject
# > 微博_屏蔽sdkconfig请求@ddgksf2013
^https?:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/sdkconfig\.php - reject

[Map Local]
# > 微博_首页信息流可能感兴趣推广@ddgksf2013
^https?:\/\/api\.weibo\.cn\/\d\/statuses\/container_positive data-type=text data=" " status-code=200
# > 微博_首页顶部弹窗@ddgksf2013
^https?:\/\/api\.weibo\.cn\/\d\/push\/info data-type=text data=" " status-code=200
# > 微博_启动感兴趣弹窗@ddgksf2013
^https?:\/\/api\.weibo\.cn\/.*account\/recommend_interesttags data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# > 微博_首页顶部直播推荐Tab@ddgksf2013
^https?:\/\/api\.weibo\.cn\/.*\/media_homelist data-type=text data=" " status-code=200
# > 微博_搜索页默认填充词@ddgksf2013
^https?:\/\/api\.weibo\.cn\/.*finder\/searchbarchange data-type=text data=" " status-code=200
# > 微博_AD_Preload@ddgksf2013
^https?:\/\/api\.weibo\.cn\/\d\/ad\/preload data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# > 微博_用户推荐弹窗@ddgksf2013
^https?:\/\/api\.weibo\.cn\/\d\/profile\/recommend_popuser data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# > 微博_每日一次的开屏广告请求@ddgksf2013
^https?:\/\/boot.*weibo\.com\/v\d\/ad\/realtime data-type=text data=" " status-code=200
# > 微博_去除底部超话栏表层浮icon及tips@ddgksf2013
^https?:\/\/api\.weibo\.cn\/.*discovery_home_bottom_getdotinfo data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# > 微博_屏蔽首页左上角每日的弹窗tips@ddgksf2013
^https?:\/\/m?api\.weibo\.c(n|om)\/\d/push/daily data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# > 微博_Spotlight@ddgksf2013
^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/hot\/hours_spotlight data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# > 微博国际版_趋势页热门影片@ddgksf2013
^https?:\/\/api\.weibo\.cn\/\d\/cardlist\?v_f=.*Weibo_intl data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# > 微博国际版_屏蔽hotsearch@ddgksf2013
^https?:\/\/weibointl\.api\.weibo\.c(n|om)\/portal\.php\?a=hot_search_users data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# > 微博国际版_屏蔽热推荐@ddgksf2013
^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/ad\/weibointl\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq ^https?:\/\/api\.weibo\.cn\/\d\/ug\/checkin\/stream '.items |= map(select(.category != "card"))'

[Script]
# > 微博_详情页及评论区@ddgksf2013
weibo_json_01 = type=http-response, pattern=^https?:\/\/api\.weibo\.cn\/\d\/statuses\/container_detail, script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/4ff1d89274c694454ac3a494ae1a2d4cfd1edf56/weibo_json.js, requires-body=true, max-size=-1, timeout=60
# > 微博_首页顶部homeExtend@ddgksf2013
weibo_json_02 = type=http-response, pattern=^https?:\/\/api\.weibo\.cn\/\d\/groups\/allgroups\/v\d, script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/4ff1d89274c694454ac3a494ae1a2d4cfd1edf56/weibo_json.js, requires-body=true, max-size=-1, timeout=60
# > 微博_开屏广告预加载处理@ddgksf2013
weibo_json_03 = type=http-response, pattern=^https?:\/\/boot.*weibo\.com\/v\d\/ad\/preload, script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/4ff1d89274c694454ac3a494ae1a2d4cfd1edf56/weibo_json.js, requires-body=true, max-size=-1, timeout=60
# > 微博_未登陆状态下首页信息流处理@ddgksf2013
weibo_json_04 = type=http-response, pattern=^https?:\/\/api\.weibo\.cn\/\d\/\w{5}\/(statuses_unread_hot_timeline|timeline), script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/4ff1d89274c694454ac3a494ae1a2d4cfd1edf56/weibo_json.js, requires-body=true, max-size=-1, timeout=60
# > 微博_视频信息处理@ddgksf2013
weibo_json_05 = type=http-response, pattern=^https?:\/\/api\.weibo\.cn\/\d\/video\/tiny_stream_mid_detail, script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/4ff1d89274c694454ac3a494ae1a2d4cfd1edf56/weibo_json.js, requires-body=true, max-size=-1, timeout=60
# > 微博_屏蔽发现页面搜索框热词@ddgksf2013
weibo_json_06 = type=http-response, pattern=^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/\w{5}\/cardlist, script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/4ff1d89274c694454ac3a494ae1a2d4cfd1edf56/weibo_json.js, requires-body=true, max-size=-1, timeout=60
# > 微博_自定义tab皮肤@zmqcherish
weibo_json_07 = type=http-response, pattern=^https://api.weibo.cn/2/!/client/light_skin, script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/4ff1d89274c694454ac3a494ae1a2d4cfd1edf56/weibo_json.js, requires-body=true, max-size=-1, timeout=60
# > 微博_非会员设置tab皮肤@zmqcherish
weibo_json_08 = type=http-response, pattern=^https://new.vip.weibo.cn/littleskin/preview, script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/4ff1d89274c694454ac3a494ae1a2d4cfd1edf56/weibo_json.js, requires-body=true, max-size=-1, timeout=60
# > 微博_去广告以及去除各部分推广模块@zmqcherish,@ddgksf2013
weibo_json_09 = type=http-response, pattern=^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/(searchall|page\?|0flowpage), script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/4ff1d89274c694454ac3a494ae1a2d4cfd1edf56/weibo_json.js, requires-body=true, max-size=-1, timeout=60
weibo_json_10 = type=http-response, pattern=^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/statuses/(unread_)?friends(/|_)timeline, script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/4ff1d89274c694454ac3a494ae1a2d4cfd1edf56/weibo_json.js, requires-body=true, max-size=-1, timeout=60
weibo_json_11 = type=http-response, pattern=^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/groups/timeline, script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/4ff1d89274c694454ac3a494ae1a2d4cfd1edf56/weibo_json.js, requires-body=true, max-size=-1, timeout=60
weibo_json_12 = type=http-response, pattern=^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/statuses/(container_timeline|unread_hot_timeline|extend|video_mixtimeline|unread_topic_timeline), script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/4ff1d89274c694454ac3a494ae1a2d4cfd1edf56/weibo_json.js, requires-body=true, max-size=-1, timeout=60
weibo_json_13 = type=http-response, pattern=^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/profile/(me|container_timeline), script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/4ff1d89274c694454ac3a494ae1a2d4cfd1edf56/weibo_json.js, requires-body=true, max-size=-1, timeout=60
weibo_json_14 = type=http-response, pattern=^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/video/(community_tab|remind_info|tiny_stream_video_list), script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/4ff1d89274c694454ac3a494ae1a2d4cfd1edf56/weibo_json.js, requires-body=true, max-size=-1, timeout=60
weibo_json_15 = type=http-response, pattern=^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/search/(finder|container_timeline|container_discover), script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/4ff1d89274c694454ac3a494ae1a2d4cfd1edf56/weibo_json.js, requires-body=true, max-size=-1, timeout=60
weibo_json_16 = type=http-response, pattern=^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/(checkin/show|\!/live/media_homelist|container/get_item), script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/4ff1d89274c694454ac3a494ae1a2d4cfd1edf56/weibo_json.js, requires-body=true, max-size=-1, timeout=60
weibo_json_17 = type=http-response, pattern=^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/cardlist, script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/4ff1d89274c694454ac3a494ae1a2d4cfd1edf56/weibo_json.js, requires-body=true, max-size=-1, timeout=60
# > 微博国际版_帖子下方广告banner@ddgksf2013
weibo_json_18 = type=http-response, pattern=^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?a=open_app, script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/4ff1d89274c694454ac3a494ae1a2d4cfd1edf56/weibo_json.js, requires-body=true, max-size=-1, timeout=60
# > 微博国际版_屏蔽searching_info@shiro
weibo_search_info = type=http-response, pattern=^https?:\/\/weibointl\.api\.weibo\.c(n|om)\/portal\.php.*a=get_searching_info, script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/08ad3524ab6924afd86ad6dc18ed48050a8abede/weibo_search_info.json, requires-body=true, max-size=-1, timeout=60
# > 微博国际版_屏蔽search_topic@shiro
weibo_search_topic = type=http-response, pattern=^https?:\/\/weibointl\.api\.weibo\.c(n|om)\/portal\.php.*feed&a=search_topic, script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/9b35fd55063e995b1ccec2f022a1c56f29d76878/weibo_search_topic.json, requires-body=true, max-size=-1, timeout=60
# > 微博国际版_屏蔽开屏广告@ddgksf2013
weibo_json_19 = type=http-response, pattern=^https?:\/\/weibointl\.api\.weibo\.c(n|om)\/portal\.php.*get_coopen_ads, script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/4ff1d89274c694454ac3a494ae1a2d4cfd1edf56/weibo_json.js, requires-body=true, max-size=-1, timeout=60
# > 微博国际版_屏蔽sdkad@ddgksf2013
weibo_json_20 = type=http-response, pattern=^https?://(sdk|wb)app\.uve\.weibo\.com(/interface/sdk/sdkad.php|/wbapplua/wbpullad.lua), script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/4ff1d89274c694454ac3a494ae1a2d4cfd1edf56/weibo_json.js, requires-body=true, max-size=-1, timeout=60
# > 微博国际版_趋势顶部Card去广告@ddgksf2013
weibo_json_21 = type=http-response, pattern=^https?:\/\/weibointl\.api\.weibo\.c(n|om)\/portal\.php.*a=trends, script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/4ff1d89274c694454ac3a494ae1a2d4cfd1edf56/weibo_json.js, requires-body=true, max-size=-1, timeout=60
# > 微博国际版_屏蔽用户VIP栏@ddgksf2013
weibo_json_22 = type=http-response, pattern=^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?a=user_center, script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/4ff1d89274c694454ac3a494ae1a2d4cfd1edf56/weibo_json.js, requires-body=true, max-size=-1, timeout=60
