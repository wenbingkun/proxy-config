#!name=小宇宙去广告
#!desc=小宇宙去广告。需要 MitM。由仓库生成。
#!category=proxy-config

# Generated by scripts/build_surge_modules.py. Do not edit by hand; change SOURCES there and rerun.
# Source: fmz200 XiaoYuZhou https://raw.githubusercontent.com/fmz200/wool_scripts/5d5f63fcf98bc69d5f8f1b1bae6f86a01ee4bb97/Surge/module/split/partX/XiaoYuZhou.sgmodule
#   sha256 be78df5d8f4b2fdef7483ed5c89e64b0e5a35f365a962911b6928cd524b82498; arguments: defaults
#   changes: preserve AI summaries, normal search, categories and recommendations

[Map Local]
# 移除开屏广告
^https?:\/\/api\.xiaoyuzhoufm\.com\/v\d\/flash-screen\/list(\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# 移除搜索框内容
^https?:\/\/api\.xiaoyuzhoufm\.com\/v\d\/search\/(get-express|get-preset)(\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/api\.xiaoyuzhoufm\.com\/v\d\/category\/list-daily-suggestion(\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq ^https?:\/\/api\.xiaoyuzhoufm\.com\/v\d\/discovery-feed\/list '.data |= map(select(.type != "DISCOVERY_BANNER"))'

[MITM]
hostname = %APPEND% api.xiaoyuzhoufm.com
