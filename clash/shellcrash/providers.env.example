# Copy this file to a persistent private path on the router and chmod it to 600.
# Never commit the real file or print its contents in logs.

SHELLCRASH_DIR='/data/other_vol/ShellCrash'
SUB_URL_1='https://your-provider.example/subscription?token=replace-me-1'
# Optional. Leave empty when only one subscription is used.
SUB_URL_2=''

# Optional overrides:
# TEMPLATE_URL='https://raw.githubusercontent.com/wenbingkun/proxy-config/main/clash/config-router.template.yaml'
# Emergency only, if the router cannot reach raw.githubusercontent.com: pin a
# commit on jsDelivr. A pinned commit stops following later updates on main;
# bump it manually or remove the line once raw is reachable again. Pick the
# template matching the subscription count:
# TEMPLATE_URL='https://cdn.jsdelivr.net/gh/wenbingkun/proxy-config@<commit>/clash/config-router-single.template.yaml'  # single (SUB_URL_2 empty)
# TEMPLATE_URL='https://cdn.jsdelivr.net/gh/wenbingkun/proxy-config@<commit>/clash/config-router.template.yaml'  # dual
# SHELLCRASH_CONFIG_PATH='/data/other_vol/ShellCrash/yamls/config.yaml'
# MIHOMO_BIN='/tmp/ShellCrash/CrashCore'
# SHELLCRASH_STARTUP_WAIT=10
# SHELLCRASH_PROVIDER_WAIT=60
