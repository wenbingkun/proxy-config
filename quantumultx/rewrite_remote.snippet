# Quantumult X custom rewrite snippet.
# Keep client-specific rewrites here when they should be synced by this repo.

# Bilibili layout cleanup, paired with the Biliverse ADBlock snippet (which
# covers ads but leaves the tab bar and the "我的" page untouched).
# Bottom bar -> 首页 / 动态 / 我的; "我的" page without 会员购 and other promos.
^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/resource\/show\/tab(\/v2)?\? url script-response-body https://raw.githubusercontent.com/wenbingkun/proxy-config/main/quantumultx/scripts/bilibili_layout.js
^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/account\/mine(\/ipad)?\? url script-response-body https://raw.githubusercontent.com/wenbingkun/proxy-config/main/quantumultx/scripts/bilibili_layout.js
# Home top-right activity entry.
^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/resource\/top\/activity url reject-dict

hostname = app.bilibili.com, app.biliapi.net
