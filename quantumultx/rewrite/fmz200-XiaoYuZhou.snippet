# Frozen modified fmz200 QX snippet; source changes require another review.
# Source: https://raw.githubusercontent.com/fmz200/wool_scripts/5d5f63fcf98bc69d5f8f1b1bae6f86a01ee4bb97/QuantumultX/rewrite/split/partX/XiaoYuZhou.snippet
# Source SHA-256: b8393c807c66c6dad18ff114dc54fc7745642099f52668f55b89dfd1cbb93d47
# Changes: small PNG icon; keep AI summaries, normal search, categories and recommendations.
# To refresh: apply scripts/xiaoyuzhou_rewrites.py preserve_features to the pinned source,
# replace #!icon with the App Store PNG, and review the result with the Loon/Surge outputs.
#############################################


# 首页净化
^https?:\/\/api\.xiaoyuzhoufm\.com\/v\d\/discovery-feed\/list url jsonjq-response-body '.data |= map(select(.type != "DISCOVERY_BANNER"))'
#

# 移除开屏广告
^https?:\/\/api\.xiaoyuzhoufm\.com\/v\d\/flash-screen\/list(\?|$) url reject-dict

# 移除搜索框内容
^https?:\/\/api\.xiaoyuzhoufm\.com\/v\d\/search\/(get-express|get-preset)(\?|$) url reject-dict
^https?:\/\/api\.xiaoyuzhoufm\.com\/v\d\/category\/list-daily-suggestion(\?|$) url reject-dict

hostname = api.xiaoyuzhoufm.com
